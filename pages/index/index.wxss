.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.input {
  height: 84rpx;
  line-height: 84rpx;
  border: 2rpx solid #e6eaf2;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  background: #fbfcff;
}

.compare-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #2575fc, #6a11cb);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.compare-btn::after {
  border: none;
}

.result-card {
  margin-top: 24rpx;
  background: #f7f9ff;
  border: 2rpx solid #dfe7ff;
  border-radius: 14rpx;
  padding: 24rpx;
}

.result-label {
  color: #666;
  font-size: 26rpx;
}

.winner {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #1f4fff;
}

.match-rate {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #1a1a1a;
}

.explanation {
  margin-top: 12rpx;
  color: #4a5568;
  line-height: 1.6;
  font-size: 28rpx;
}

.slider-card {
  padding-top: 22rpx;
}

.slider-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.slider-item {
  margin-bottom: 12rpx;
}

.slider-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #333;
}
